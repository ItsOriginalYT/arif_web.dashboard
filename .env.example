# Copy to .env for local deployment overrides and launch with node --env-file=.env server.mjs.
ADAM_TRANSPORT=local
ADAM_HOST=127.0.0.1
ADAM_PORT=8765
ADAM_DATA=data

# For tls or proxy mode, set the exact browser HTTPS origin without a trailing slash.
# ADAM_PUBLIC_ORIGIN=https://adam-server-1:8765

# For direct tls mode, point these at the certificate chain and private key.
# ADAM_TLS_CERT=C:/Dashboard-TLS/fullchain.pem
# ADAM_TLS_KEY=C:/Dashboard-TLS/privkey.pem

# Inject OPENF1_USERNAME and OPENF1_PASSWORD from your service account's secret store.
